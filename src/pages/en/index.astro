---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import AboutMe from "@/components/AboutMe.astro";
import TechStack from "@/components/TechStack.astro";
import Testimonials from "@/components/Testimonials.astro";
import { PortfolioService } from "@/services/data.service";

const globalSettings = await PortfolioService.getGlobalSettings();
const brandName = globalSettings?.brand_name || "bdvela";

const title = `${brandName} - Web Developer`;
const description =
  "Custom website developer for your business or personal brand. +5 years of experience creating attractive and functional websites that turn visitors into clients.";
---

<Layout title={title} description={description}>
  <Hero />
  <TechStack />
  <Experience />
  <Projects />
  <Testimonials />
  <AboutMe />
</Layout>
