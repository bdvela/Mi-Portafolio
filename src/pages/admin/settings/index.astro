---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Sidebar from "@/components/admin/Sidebar.astro";
import MagneticButton from "@/components/ui/MagneticButton.astro";
import { PortfolioService } from "@/services/data.service";
import { Icon } from "astro-icon/components";

const settings = await PortfolioService.getGlobalSettings() || {
    email: "",
    brand_name: "bdvela",
    phone: "",
    whatsapp_url: "",
    linkedin_url: "",
    github_url: "",
    instagram_url: "",
    facebook_url: "",
    resume_url: ""
};

const urlParams = Astro.url.searchParams;
const success = urlParams.get('success');
---

<AdminLayout title="Configuraciones Globales">
    <div class="flex">
        <Sidebar />
        <main class="flex-1 p-8">
            <header class="mb-12">
                <div class="flex items-center gap-4 mb-2">
                    <div class="size-12 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 border border-indigo-500/20">
                        <Icon name="mdi:cog" class="size-6" />
                    </div>
                    <div>
                        <h1 class="text-3xl font-black text-white tracking-tight">Configuraciones Globales</h1>
                        <p class="text-gray-500 font-medium">Gestiona datos reutilizables y redes sociales</p>
                    </div>
                </div>
            </header>

            {success && (
                <div class="mb-8 p-4 bg-green-500/10 border border-green-500/20 rounded-2xl flex items-center gap-3 text-green-400 animate-fade-in">
                    <Icon name="mdi:check-circle" class="size-5" />
                    <span class="font-bold text-sm uppercase tracking-widest">Configuraciones actualizadas con éxito</span>
                </div>
            )}

            <form action="/admin/api/settings/upsert" method="POST" enctype="multipart/form-data" class="max-w-4xl space-y-12 pb-20">
                <!-- Información de Contacto -->
                <section class="reveal">
                    <div class="flex items-center gap-3 mb-6 ml-2">
                        <div class="size-2 rounded-full bg-indigo-500"></div>
                        <h2 class="text-xs font-black text-white/40 uppercase tracking-[0.3em]">Marca y Contacto</h2>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="p-8 rounded-[2rem] bg-white/5 border border-white/10 space-y-4 group">
                            <label class="block text-xs font-black text-gray-500 uppercase tracking-widest group-focus-within:text-indigo-400 transition-colors">Nombre de Marca</label>
                            <input 
                                type="text" 
                                name="brand_name" 
                                value={settings.brand_name}
                                class="w-full bg-transparent border-b border-white/10 py-2 text-white font-medium outline-none focus:border-indigo-500 transition-colors"
                                placeholder="bdvela"
                            />
                        </div>
                        <div class="p-8 rounded-[2rem] bg-white/5 border border-white/10 space-y-4 group">
                            <label class="block text-xs font-black text-gray-500 uppercase tracking-widest group-focus-within:text-indigo-400 transition-colors">Email</label>
                            <input 
                                type="email" 
                                name="email" 
                                value={settings.email}
                                class="w-full bg-transparent border-b border-white/10 py-2 text-white font-medium outline-none focus:border-indigo-500 transition-colors"
                                placeholder="ejemplo@correo.com"
                            />
                        </div>
                        <div class="p-8 rounded-[2rem] bg-white/5 border border-white/10 space-y-4 group">
                            <label class="block text-xs font-black text-gray-500 uppercase tracking-widest group-focus-within:text-indigo-400 transition-colors">Teléfono / WhatsApp</label>
                            <input 
                                type="text" 
                                name="phone" 
                                value={settings.phone}
                                class="w-full bg-transparent border-b border-white/10 py-2 text-white font-medium outline-none focus:border-indigo-500 transition-colors"
                                placeholder="+51 999 999 999"
                            />
                        </div>
                    </div>
                </section>

                <!-- Redes Sociales -->
                <section class="reveal" style="animation-delay: 100ms">
                    <div class="flex items-center gap-3 mb-6 ml-2">
                        <div class="size-2 rounded-full bg-purple-500"></div>
                        <h2 class="text-xs font-black text-white/40 uppercase tracking-[0.3em]">Presencia Digital</h2>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        { [
                            { name: "linkedin_url", label: "LinkedIn", icon: "mdi:linkedin" },
                            { name: "github_url", label: "GitHub", icon: "mdi:github" },
                            { name: "whatsapp_url", label: "WhatsApp Link", icon: "mdi:whatsapp" },
                            { name: "instagram_url", label: "Instagram", icon: "mdi:instagram" },
                            { name: "facebook_url", label: "Facebook", icon: "mdi:facebook" }
                        ].map((social) => (
                            <div class="p-6 rounded-3xl bg-white/5 border border-white/10 flex items-center gap-6 group">
                                <div class="size-12 rounded-2xl bg-white/5 flex items-center justify-center text-gray-500 group-focus-within:bg-indigo-500/20 group-focus-within:text-indigo-400 transition-all border border-white/5 group-focus-within:border-indigo-500/20">
                                    <Icon name={social.icon} class="size-6" />
                                </div>
                                <div class="flex-1 space-y-1">
                                    <label class="block text-[10px] font-black text-gray-600 uppercase tracking-widest group-focus-within:text-indigo-400/60 transition-colors">{social.label}</label>
                                    <input 
                                        type="url" 
                                        name={social.name} 
                                        value={(settings as any)[social.name]}
                                        class="w-full bg-transparent py-1 text-sm text-white font-bold outline-none border-b border-white/5 focus:border-indigo-500 transition-all"
                                        placeholder="https://..."
                                    />
                                </div>
                            </div>
                        )) }
                    </div>
                </section>

                <!-- Documentación y Recursos -->
                <section class="reveal" style="animation-delay: 200ms">
                    <div class="flex items-center gap-3 mb-6 ml-2">
                        <div class="size-2 rounded-full bg-emerald-500"></div>
                        <h2 class="text-xs font-black text-white/40 uppercase tracking-[0.3em]">Documentación y Recursos</h2>
                    </div>
                    
                    <div class="grid grid-cols-1 gap-8">
                        <!-- Currículum Vitae -->
                        <div class="bg-white/5 p-8 rounded-[2.5rem] border border-white/10 space-y-8 relative overflow-hidden group">
                             <div class="absolute top-0 right-0 p-6 opacity-[0.03] group-hover:scale-110 transition-transform duration-500">
                                <Icon name="mdi:file-document-outline" class="size-32" />
                            </div>

                            <div class="flex items-center gap-4 relative z-10">
                                <div class="size-12 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 border border-emerald-500/20 shadow-lg">
                                    <Icon name="mdi:file-pdf-box" class="size-6" />
                                </div>
                                <div class="flex-1">
                                    <h3 class="text-xl font-black text-white tracking-tight">Gestión de Currículum</h3>
                                    <p class="text-xs text-gray-500 font-medium">Sube tus versiones actualizadas en ES y EN</p>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
                                <!-- CV Español -->
                                <div class="p-6 rounded-3xl bg-white/[0.03] border border-white/5 space-y-5 hover:bg-white/[0.05] transition-colors">
                                    <div class="flex items-center justify-between">
                                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Versión Español</label>
                                        <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-[8px] font-black text-blue-400 uppercase tracking-tighter">PDF / DOC</span>
                                    </div>
                                    
                                    {settings?.resume_url_es && (
                                        <div class="flex items-center gap-3 text-xs text-blue-300 bg-blue-400/5 px-4 py-3 rounded-2xl border border-blue-400/10">
                                            <Icon name="mdi:check-decagram" class="size-4 text-green-500" />
                                            <p class="truncate flex-1 font-mono italic opacity-70 text-[10px]">{settings.resume_url_es.split('/').pop()}</p>
                                            <a href={settings.resume_url_es} target="_blank" class="hover:text-white transition-colors">
                                                <Icon name="mdi:eye" class="size-4" />
                                            </a>
                                        </div>
                                    )}
                                    
                                    <div class="relative group/file">
                                        <input type="file" name="resume_file_es" accept=".pdf,.doc,.docx" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" />
                                        <div class="px-5 py-4 rounded-2xl bg-white/5 border border-white/10 text-white text-xs font-black flex items-center justify-center gap-3 group-hover/file:bg-white/10 group-hover/file:border-white/20 transition-all shadow-lg group-active/file:scale-95">
                                            <Icon name="mdi:upload" class="size-4 text-emerald-400" />
                                            Reemplazar archivo (ES)
                                        </div>
                                    </div>
                                    <input type="hidden" name="resume_url_es" value={settings?.resume_url_es || ""} />
                                </div>

                                <!-- CV Inglés -->
                                <div class="p-6 rounded-3xl bg-white/[0.03] border border-white/5 space-y-5 hover:bg-white/[0.05] transition-colors">
                                    <div class="flex items-center justify-between">
                                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Versión Inglés</label>
                                        <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-[8px] font-black text-blue-400 uppercase tracking-tighter">PDF / DOC</span>
                                    </div>
                                    
                                    {settings?.resume_url_en && (
                                        <div class="flex items-center gap-3 text-xs text-blue-300 bg-blue-400/5 px-4 py-3 rounded-2xl border border-blue-400/10">
                                            <Icon name="mdi:check-decagram" class="size-4 text-green-500" />
                                            <p class="truncate flex-1 font-mono italic opacity-70 text-[10px]">{settings.resume_url_en.split('/').pop()}</p>
                                            <a href={settings.resume_url_en} target="_blank" class="hover:text-white transition-colors">
                                                <Icon name="mdi:eye" class="size-4" />
                                            </a>
                                        </div>
                                    )}
                                    
                                    <div class="relative group/file">
                                        <input type="file" name="resume_file_en" accept=".pdf,.doc,.docx" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" />
                                        <div class="px-5 py-4 rounded-2xl bg-white/5 border border-white/10 text-white text-xs font-black flex items-center justify-center gap-3 group-hover/file:bg-white/10 group-hover/file:border-white/20 transition-all shadow-lg group-active/file:scale-95">
                                            <Icon name="mdi:upload" class="size-4 text-blue-400" />
                                            Reemplazar archivo (EN)
                                        </div>
                                    </div>
                                    <input type="hidden" name="resume_url_en" value={settings?.resume_url_en || ""} />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                        <div class="p-8 rounded-[2.5rem] bg-white/5 border border-white/10 space-y-6 group opacity-50 cursor-not-allowed">
                             <div class="flex items-center gap-4">
                                <div class="size-10 rounded-xl bg-gray-500/10 flex items-center justify-center text-gray-400 border border-gray-500/20">
                                    <Icon name="mdi:image-multiple" class="size-5" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest">Logo / Favicon</label>
                                    <p class="text-[9px] text-gray-600 font-bold uppercase tracking-tighter">Próximamente: Gestión de assets visuales</p>
                                </div>
                            </div>
                            <div class="h-[60px] border-2 border-dashed border-white/5 rounded-2xl flex items-center justify-center">
                                <span class="text-[8px] font-bold text-gray-700 uppercase tracking-widest">Próxima Fase</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Botón Flotante -->
                <div class="fixed bottom-12 right-12 z-50">
                    <MagneticButton type="submit" class="px-10 py-5 shadow-[0_20px_40px_-15px_rgba(79,70,229,0.5)]">
                        <Icon name="mdi:content-save" class="size-5" />
                        Guardar Cambios
                    </MagneticButton>
                </div>
            </form>
        </main>
    </div>
</AdminLayout>

<style>
    .reveal {
        animation: reveal 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    /* Hide scrollbar but keep functionality */
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
