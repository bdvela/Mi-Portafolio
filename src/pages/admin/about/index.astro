---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Sidebar from "@/components/admin/Sidebar.astro";
import MagneticButton from "@/components/ui/MagneticButton.astro";
import { PortfolioService } from "@/services/data.service";
import { Icon } from "astro-icon/components";

// removed unused AboutData import

const aboutEs = await PortfolioService.getAbout("es") || { 
    lang: "es", 
    description_1: "", 
    description_2: "", 
    description_3: "",
    skills_json: { FRONTEND: "Frontend", BACKEND: "Backend", SAP: "SAP/FIORI", UIUX: "UI/UX" },
    highlights_json: { TROPHY: "1° Lugar", TROPHY_SUB: "ULATINHACK 2022", DEGREE: "Ing. Software", DEGREE_SUB: "UPC Lima" },
    values_json: { FAITH_CODE: "Fe & Código", LOCATION: "Lima, Perú" }
};

const aboutEn = await PortfolioService.getAbout("en") || { 
    lang: "en", 
    description_1: "", 
    description_2: "", 
    description_3: "",
    skills_json: { FRONTEND: "Frontend", BACKEND: "Backend", SAP: "SAP/FIORI", UIUX: "UI/UX" },
    highlights_json: { TROPHY: "1st Place", TROPHY_SUB: "ULATINHACK 2022", DEGREE: "Software Eng.", DEGREE_SUB: "UPC Lima" },
    values_json: { FAITH_CODE: "Faith & Code", LOCATION: "Lima, Peru" }
};

const shared = {
    profile_image_url: aboutEs.profile_image_url || aboutEn.profile_image_url || "",
    skills: (aboutEs.skills_json || aboutEn.skills_json || {}) as Record<string, any>,
    highlights: (aboutEs.highlights_json || aboutEn.highlights_json || {}) as Record<string, any>,
    values: (aboutEs.values_json || aboutEn.values_json || {}) as Record<string, any>
};

const colorMap: Record<string, string> = {
  purple: "text-purple-400 bg-purple-500/10 border-purple-500/20",
  blue: "text-blue-400 bg-blue-500/10 border-blue-500/20",
  cyan: "text-cyan-400 bg-cyan-500/10 border-cyan-500/20",
  pink: "text-pink-400 bg-pink-500/10 border-pink-500/20",
  orange: "text-orange-400 bg-orange-500/10 border-orange-500/20",
  green: "text-green-400 bg-green-500/10 border-green-500/20",
};
---

<AdminLayout title="Gestionar Sobre mí (Unificado)">
    <div class="flex flex-col lg:flex-row min-h-screen">
        <Sidebar />
        <main class="flex-1 p-4 sm:p-6 lg:p-8 min-w-0">
            <header class="mb-8">
                <h1 class="text-3xl font-bold text-white">Sobre mí</h1>
                <p class="text-gray-400 mt-2">Gestiona tu biografía, habilidades y destacados.</p>
            </header>

            <form action="/admin/api/about/upsert-unified" method="POST" enctype="multipart/form-data" class="max-w-6xl space-y-8 pb-20">
                
                <!-- Tab Navigation -->
                <div class="flex flex-wrap gap-2 p-1.5 bg-white/5 rounded-2xl w-full sm:w-fit border border-white/10 mb-8 backdrop-blur-md">
                    <button type="button" data-tab="identity" class="tab-btn active flex-1 sm:flex-none px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black transition-all flex items-center justify-center gap-2 group">
                        <Icon name="mdi:account-box-outline" class="size-5 transition-transform group-hover:scale-110" />
                        Identidad
                    </button>
                    <button type="button" data-tab="skills" class="tab-btn flex-1 sm:flex-none px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black transition-all text-gray-500 hover:text-gray-300 flex items-center justify-center gap-2 group">
                        <Icon name="mdi:star-outline" class="size-5 transition-transform group-hover:scale-110" />
                        Habilidades
                    </button>
                    <button type="button" data-tab="bio" class="tab-btn flex-1 sm:flex-none px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black transition-all text-gray-500 hover:text-gray-300 flex items-center justify-center gap-2 group">
                        <Icon name="mdi:text-account" class="size-5 transition-transform group-hover:scale-110" />
                        Biografía
                    </button>
                </div>

                <!-- Tab: Identity -->
                <section id="tab-identity" class="tab-content space-y-6 sm:space-y-8 animate-in fade-in slide-in-from-bottom-2 duration-500">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
                        <!-- Profile Card Visual -->
                        <div class="bg-[#05091e] p-6 sm:p-10 rounded-3xl sm:rounded-[2.5rem] border border-white/5 shadow-2xl space-y-8 relative overflow-hidden group/main">
                            <div class="absolute top-0 right-0 p-4 sm:p-8 opacity-10">
                                <Icon name="mdi:account-details-outline" class="size-32" />
                            </div>
                            
                            <h2 class="text-xs font-black text-purple-500/50 uppercase tracking-[0.3em] mb-4">Identidad Visual</h2>
                            
                            <div class="flex flex-col items-center gap-8 relative z-10">
                                <div class="relative group">
                                    <div class="absolute -inset-4 bg-gradient-to-tr from-purple-500/20 to-blue-500/20 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                                    <div class="w-44 h-44 rounded-[3rem] overflow-hidden border-4 border-white/10 bg-white/5 shadow-2xl relative transition-all duration-700 group-hover:rounded-[2rem] group-hover:scale-105">
                                        {shared.profile_image_url ? (
                                            <img src={shared.profile_image_url} alt="Profile" class="w-full h-full object-cover" />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-gray-700">
                                                <Icon name="mdi:account-circle" class="size-24" />
                                            </div>
                                        )}
                                        <div class="absolute inset-0 bg-[#05091e]/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center backdrop-blur-md">
                                            <Icon name="mdi:camera-flip-outline" class="size-10 text-white mb-2" />
                                            <p class="text-[10px] font-black text-white uppercase tracking-widest">Cambiar Foto</p>
                                        </div>
                                    </div>
                                    <input type="file" name="profile_image" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-20" />
                                </div>
                                <div class="text-center">
                                    <p class="text-[10px] text-gray-500 font-black uppercase tracking-widest mb-1">Imagen de Perfil</p>
                                    <p class="text-xs text-purple-400 font-bold">Haz clic en la imagen para subir una nueva</p>
                                    <input type="hidden" name="profile_image_url" value={shared.profile_image_url} />
                                </div>
                            </div>

                            <div class="pt-8 border-t border-white/5 space-y-4 sm:space-y-6">
                                <div class="space-y-2">
                                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest ml-4">Eslogan Personal</label>
                                    <input type="text" name="val_faith" value={shared.values?.FAITH_CODE} class="w-full px-5 sm:px-6 py-3 sm:py-4 rounded-xl sm:rounded-2xl bg-white/5 border border-white/10 text-white text-sm sm:text-base font-bold focus:ring-4 focus:ring-purple-500/10 focus:border-purple-500/40 outline-none transition-all placeholder:text-gray-700" placeholder="Ej: Fe & Código" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest ml-4">Ubicación Actual</label>
                                    <div class="relative group/input">
                                        <Icon name="mdi:map-marker-radius-outline" class="absolute left-5 sm:left-6 top-1/2 -translate-y-1/2 size-4 sm:size-5 text-gray-600 group-focus-within/input:text-purple-400 transition-colors" />
                                        <input type="text" name="val_location" value={shared.values?.LOCATION} class="w-full pl-12 sm:pl-14 pr-5 sm:pr-6 py-3 sm:py-4 rounded-xl sm:rounded-2xl bg-white/5 border border-white/10 text-white text-sm sm:text-base font-bold focus:ring-4 focus:ring-purple-500/10 focus:border-purple-500/40 outline-none transition-all placeholder:text-gray-700" placeholder="Ej: Lima, Perú" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar Info / Tips -->
                        <div class="flex flex-col gap-6 sm:gap-8">
                            <div class="bg-blue-600/5 p-6 sm:p-10 rounded-3xl sm:rounded-[2.5rem] border border-blue-500/10 relative overflow-hidden">
                                 <div class="size-12 sm:size-14 rounded-xl sm:rounded-2xl bg-blue-500/20 flex items-center justify-center mb-6 border border-blue-500/20 shadow-xl shadow-blue-500/10">
                                    <Icon name="mdi:lightbulb-on-outline" class="size-6 sm:size-7 text-blue-400" />
                                 </div>
                                 <h3 class="text-lg sm:text-xl font-bold text-white mb-3">Impacto Profesional</h3>
                                 <p class="text-xs sm:text-sm text-gray-400 leading-relaxed mb-6 font-medium">Tu identidad define la primera impresión. Un eslogan potente y una foto de alta calidad elevan tu autoridad como desarrollador.</p>
                                 <ul class="space-y-4">
                                    <li class="flex items-start gap-4 text-[10px] sm:text-xs text-gray-500 font-bold group">
                                        <div class="size-5 rounded-md bg-green-500/20 flex items-center justify-center shrink-0 mt-0.5"><Icon name="mdi:check" class="text-green-500 size-3" /></div>
                                        <span>Relación de aspecto 4:5 recomendada</span>
                                    </li>
                                    <li class="flex items-start gap-4 text-[10px] sm:text-xs text-gray-500 font-bold group">
                                        <div class="size-5 rounded-md bg-green-500/20 flex items-center justify-center shrink-0 mt-0.5"><Icon name="mdi:check" class="text-green-500 size-3" /></div>
                                        <span>Fondo limpio para evitar distracciones</span>
                                    </li>
                                 </ul>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Tab: Skills & Highlights -->
                <section id="tab-skills" class="tab-content hidden space-y-6 sm:space-y-8 animate-in fade-in slide-in-from-bottom-2 duration-500">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
                        <!-- Skills Layout -->
                        <div class="bg-white/5 p-6 sm:p-10 rounded-3xl sm:rounded-[2.5rem] border border-white/5 space-y-8">
                            <h2 class="text-lg font-black text-white flex items-center gap-4">
                                <div class="size-10 rounded-xl bg-yellow-500/10 flex items-center justify-center border border-yellow-500/20 shadow-lg shadow-yellow-500/10"><Icon name="mdi:flash-outline" class="size-6 text-yellow-500" /></div>
                                Habilidades Core
                            </h2>
                            <div class="space-y-4 sm:space-y-6">
                                {(Array.isArray(shared.skills) ? shared.skills : [
                                    { key: "FRONTEND", label: shared.skills?.FRONTEND || "Frontend", icon: "mdi:palette-swatch-outline", color: "purple" },
                                    { key: "BACKEND", label: shared.skills?.BACKEND || "Backend", icon: "mdi:xml", color: "blue" },
                                    { key: "SAP", label: shared.skills?.SAP || "SAP/FIORI", icon: "mdi:layers-triple-outline", color: "cyan" },
                                    { key: "UIUX", label: shared.skills?.UIUX || "UI/UX", icon: "mdi:vector-bezier", color: "pink" }
                                ]).map((skill: any, idx) => (
                                    <div class="p-4 sm:p-6 rounded-2xl sm:rounded-3xl bg-white/5 border border-white/10 space-y-4 sm:space-y-6 hover:bg-white/[0.08] transition-all group">
                                        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6">
                                            <div class={`w-14 h-14 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform shadow-xl border ${colorMap[skill.color] || "bg-white/5 border-white/10"}`}>
                                                <Icon name={skill.icon || "mdi:star"} class="size-6 sm:size-8" />
                                            </div>
                                            <div class="flex-1 w-full grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                                                <div class="space-y-1">
                                                    <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest ml-1">Icono (MDI)</label>
                                                    <input type="text" name={`skill_icon_${idx}`} value={skill.icon} class="w-full bg-black/20 px-3 py-2 rounded-lg text-white text-xs font-mono border border-white/5 focus:border-yellow-500/40 outline-none" placeholder="mdi:code" />
                                                </div>
                                                <div class="space-y-1">
                                                    <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest ml-1">Color (Tailwind)</label>
                                                    <select name={`skill_color_${idx}`} class="w-full bg-black/20 px-3 py-2 rounded-lg text-white text-xs border border-white/5 outline-none">
                                                        <option value="purple" selected={skill.color === "purple"}>Púrpura</option>
                                                        <option value="blue" selected={skill.color === "blue"}>Azul</option>
                                                        <option value="cyan" selected={skill.color === "cyan"}>Cian</option>
                                                        <option value="pink" selected={skill.color === "pink"}>Rosa</option>
                                                        <option value="orange" selected={skill.color === "orange"}>Naranja</option>
                                                        <option value="green" selected={skill.color === "green"}>Verde</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 pt-4 border-t border-white/5">
                                            <div class="space-y-1 text-center sm:text-left">
                                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest ml-1">Categoría / Tag</label>
                                                <input type="text" name={`skill_key_${idx}`} value={skill.key} class="w-full bg-transparent text-gray-400 font-black text-[10px] uppercase tracking-widest text-center sm:text-left outline-none border-b border-transparent focus:border-white/10" placeholder="KEY" />
                                            </div>
                                            <div class="space-y-1 text-center sm:text-left">
                                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest ml-1">Nombre Visible</label>
                                                <input type="text" name={`skill_label_${idx}`} value={skill.label} class="w-full bg-transparent text-white font-black text-sm text-center sm:text-left outline-none border-b border-transparent focus:border-yellow-500/40" placeholder="Nombre de Habilidad" />
                                            </div>
                                        </div>
                                    </div>
                                ))}
                                <p class="text-[10px] text-gray-500 text-center italic mt-4">Usa el formato "mdi:nombre-icono" para los iconos. Puedes verlos en icon-sets.iconify.design/mdi/</p>
                            </div>
                        </div>

                        <!-- Highlights Visual -->
                        <div class="bg-white/5 p-6 sm:p-10 rounded-3xl sm:rounded-[2.5rem] border border-white/5 space-y-8">
                            <h2 class="text-lg font-black text-white flex items-center gap-4">
                                <div class="size-10 rounded-xl bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20 shadow-lg shadow-indigo-500/10"><Icon name="mdi:trophy-outline" class="size-6 text-indigo-400" /></div>
                                Logros Principales
                            </h2>
                            <div class="space-y-4 sm:space-y-6">
                                <div class="p-6 sm:p-8 rounded-2xl sm:rounded-[2rem] bg-gradient-to-br from-purple-500/10 to-indigo-500/10 border border-purple-500/20 hover:border-purple-500/40 transition-all group shadow-xl">
                                    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 mb-6">
                                        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-white/10 flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:rotate-6 transition-all border border-white/10 shadow-2xl"><Icon name="mdi:trophy-variant" class="size-7 sm:size-9 text-indigo-400" /></div>
                                        <div class="flex-1 w-full text-center sm:text-left min-w-0">
                                            <input type="text" name="high_trophy" value={shared.highlights?.TROPHY} class="w-full bg-transparent text-white font-black text-lg sm:text-xl text-center sm:text-left outline-none truncate" placeholder="Premio/Logro" />
                                            <input type="text" name="high_trophy_sub" value={shared.highlights?.TROPHY_SUB} class="w-full bg-transparent text-gray-500 text-[10px] sm:text-xs font-bold uppercase tracking-widest mt-1 text-center sm:text-left outline-none truncate" placeholder="Descripción corta" />
                                        </div>
                                    </div>
                                    <div class="h-1 bg-white/5 rounded-full overflow-hidden">
                                        <div class="w-full h-full bg-indigo-500 shadow-[0_0_15px_rgba(99,102,241,0.5)]"></div>
                                    </div>
                                </div>

                                <div class="p-6 sm:p-8 rounded-2xl sm:rounded-[2rem] bg-gradient-to-br from-green-500/10 to-teal-500/10 border border-green-500/20 hover:border-green-500/40 transition-all group shadow-xl">
                                    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 mb-6">
                                        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-white/10 flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:-rotate-6 transition-all border border-white/10 shadow-2xl"><Icon name="mdi:school" class="size-7 sm:size-9 text-green-400" /></div>
                                        <div class="flex-1 w-full text-center sm:text-left min-w-0">
                                            <input type="text" name="high_degree" value={shared.highlights?.DEGREE} class="w-full bg-transparent text-white font-black text-lg sm:text-xl text-center sm:text-left outline-none truncate" placeholder="Educación/Grado" />
                                            <input type="text" name="high_degree_sub" value={shared.highlights?.DEGREE_SUB} class="w-full bg-transparent text-gray-500 text-[10px] sm:text-xs font-bold uppercase tracking-widest mt-1 text-center sm:text-left outline-none truncate" placeholder="Institución" />
                                        </div>
                                    </div>
                                    <div class="h-1 bg-white/5 rounded-full overflow-hidden">
                                        <div class="w-[85%] h-full bg-green-500 shadow-[0_0_15px_rgba(34,197,94,0.5)]"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Tab: Biography -->
                <section id="tab-bio" class="tab-content hidden animate-in fade-in slide-in-from-bottom-2 duration-500">
                    <div class="bg-[#05091e]/50 border border-white/5 rounded-3xl sm:rounded-[3rem] shadow-2xl overflow-hidden backdrop-blur-xl">
                        <div class="p-6 sm:p-10 border-b border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white/[0.02]">
                            <div>
                                <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">Narrativa Personal</h2>
                                <p class="text-xs sm:text-sm text-gray-500 mt-2 font-medium italic">"Escribe normal", la traducción al inglés se genera automáticamente.</p>
                            </div>
                            <div class="flex gap-4">
                                <div class="flex items-center gap-2 px-4 py-2 bg-purple-500/10 rounded-full ring-1 ring-purple-500/20 w-fit">
                                    <div class="size-1.5 rounded-full bg-purple-400 animate-pulse"></div>
                                    <span class="text-[10px] font-black text-purple-400 uppercase tracking-widest">IA Auto-Trans Ready</span>
                                </div>
                            </div>
                        </div>
                        <div class="p-6 sm:p-10 space-y-6">
                            <div class="space-y-4 group">
                                <div class="flex items-center gap-3 ml-2">
                                    <div class="size-8 rounded-xl bg-purple-500/20 flex items-center justify-center text-xs font-black text-purple-400 border border-purple-500/20 group-focus-within:bg-purple-500 group-focus-within:text-white transition-all">
                                        <Icon name="mdi:fountain-pen-tip" class="size-4" />
                                    </div>
                                    <label class="text-[10px] sm:text-xs font-black text-gray-600 uppercase tracking-[0.2em] group-focus-within:text-purple-400 transition-colors">
                                        Tu Historia
                                    </label>
                                </div>
                                <textarea 
                                    name="biography_es" 
                                    rows="12" 
                                    class="w-full px-6 sm:px-8 py-6 sm:py-8 rounded-2xl sm:rounded-[3rem] bg-white/5 border border-white/10 text-gray-300 text-sm sm:text-lg font-medium leading-relaxed outline-none focus:ring-8 focus:ring-purple-500/5 focus:border-purple-500/40 focus:bg-white/[0.08] transition-all scrollbar-hide"
                                    placeholder="Escribe tu historia completa aquí..."
                                >{[aboutEs.description_1, aboutEs.description_2, aboutEs.description_3].filter(Boolean).join('\n\n')}</textarea>
                                <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-10 px-6 sm:px-8 py-4 bg-white/5 rounded-2xl border border-white/5">
                                    <div class="flex items-center gap-3">
                                        <div class="size-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></div>
                                        <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Auto-Save Ready</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <div class="size-2 rounded-full bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.5)]"></div>
                                        <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">HTML Support</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="flex justify-center sm:justify-end gap-6 pt-12 border-t border-white/10">
                    <MagneticButton type="submit" class="w-full sm:w-auto px-10 sm:px-16 py-4 sm:py-5 shadow-2xl">
                        <Icon name="mdi:cloud-upload-outline" class="size-5 sm:size-6" />
                        Guardar Cambios
                    </MagneticButton>
                </div>
            </form>

            <style>
                .tab-btn.active {
                    background: rgba(255, 255, 255, 0.1);
                    color: white;
                    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
                }
                .scrollbar-hide::-webkit-scrollbar {
                    display: none;
                }
                @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
                @keyframes slide-in-from-bottom-2 { from { transform: translateY(8px); } to { transform: translateY(0); } }
                .animate-in { animation: fade-in 0.5s ease-out, slide-in-from-bottom-2 0.5s ease-out; }
            </style>

            <script>
                // Tab Logic
                const tabs = document.querySelectorAll('.tab-btn');
                const contents = document.querySelectorAll('.tab-content');

                tabs.forEach(tab => {
                    tab.addEventListener('click', () => {
                        const target = tab.getAttribute('data-tab');

                        tabs.forEach(t => {
                            t.classList.remove('active');
                            t.classList.add('text-gray-500');
                        });
                        tab.classList.add('active');
                        tab.classList.remove('text-gray-500');

                        contents.forEach(content => {
                            if (content.id === `tab-${target}`) {
                                content.classList.remove('hidden');
                            } else {
                                content.classList.add('hidden');
                            }
                        });
                    });
                });
            </script>
        </main>
    </div>
</AdminLayout>
