---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Sidebar from "@/components/admin/Sidebar.astro";
import MagneticButton from "@/components/ui/MagneticButton.astro";
import { PortfolioService } from "@/services/data.service";
import type { TestimonialData } from "@/models/portfolio";

const { id } = Astro.params;
const isNew = id === "new";

let testimonialEs: TestimonialData = {
    lang: "es",
    author: "",
    company: "",
    review: "",
    order_index: 0,
    group_id: ""
};

let testimonialEn: TestimonialData = {
    lang: "en",
    author: "",
    company: "",
    review: "",
    order_index: 0,
    group_id: ""
};

if (!isNew && id) {
    const testimonial = await PortfolioService.getTestimonialById(id);
    if (testimonial && testimonial.group_id) {
        const group = await PortfolioService.getTestimonialGroup(testimonial.group_id);
        testimonialEs = group.find(t => t.lang === 'es') || { ...testimonialEs, group_id: testimonial.group_id };
        testimonialEn = group.find(t => t.lang === 'en') || { ...testimonialEn, group_id: testimonial.group_id };
    } else if (testimonial) {
        if (testimonial.lang === 'es') testimonialEs = testimonial;
        else testimonialEn = testimonial;
    }
}

const shared = {
    author: testimonialEs.author || testimonialEn.author || "",
    company: testimonialEs.company || testimonialEn.company || "",
    order_index: testimonialEs.order_index ?? testimonialEn.order_index ?? 0,
    group_id: testimonialEs.group_id || testimonialEn.group_id || ""
};
---

<AdminLayout title={isNew ? "Nuevo Testimonio (Unificado)" : "Editar Testimonio (Unificado)"}>
    <div class="flex">
        <Sidebar />
        <main class="flex-1 p-8">
            <header class="mb-8">
                <h1 class="text-3xl font-bold text-white">{isNew ? "Nuevo Testimonio" : "Editar Testimonio"}</h1>
                <p class="text-gray-400 mt-2">Configura el testimonio fácilmente.</p>
            </header>

            <form action="/admin/api/testimonials/upsert-unified" method="POST" class="max-w-5xl space-y-8 pb-20">
                <input type="hidden" name="group_id" value={shared.group_id} />
                <input type="hidden" name="id_es" value={testimonialEs.id} />
                <input type="hidden" name="id_en" value={testimonialEn.id} />

                <!-- Configuración Compartida -->
                <section class="bg-white/5 p-8 rounded-2xl border border-white/10 space-y-6">
                    <h2 class="text-xl font-bold text-blue-400 flex items-center gap-2">
                        <span class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-400 text-sm">1</span>
                        Metadatos Compartidos
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-gray-300 mb-2">Autor</label>
                            <input 
                                type="text" 
                                name="author" 
                                value={shared.author} 
                                required
                                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white outline-none focus:ring-2 focus:ring-blue-500/50 transition-all placeholder:text-gray-600" 
                                placeholder="Nombre del autor"
                            />
                        </div>
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-gray-300 mb-2">Empresa / Cargo</label>
                            <input 
                                type="text" 
                                name="company" 
                                value={shared.company} 
                                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white outline-none focus:ring-2 focus:ring-blue-500/50 transition-all" 
                            />
                        </div>
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-gray-300 mb-2">Orden</label>
                            <input 
                                type="number" 
                                name="order_index" 
                                value={shared.order_index} 
                                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white outline-none focus:ring-2 focus:ring-blue-500/50 transition-all" 
                            />
                        </div>
                    </div>
                </section>

                <!-- Contenido (Español) -->
                <div class="space-y-8">
                    <!-- Español -->
                    <section class="bg-white/5 p-8 rounded-2xl border border-purple-500/20 space-y-6 relative overflow-hidden">
                        <h2 class="text-xl font-bold text-purple-400 flex items-center gap-2 pt-2">
                             Reseña del Testimonio
                        </h2>
                        
                        <div>
                            <label class="block text-sm font-medium text-purple-300/70 mb-2 uppercase tracking-wider">Reseña</label>
                            <textarea 
                                name="review_es" 
                                rows="6" 
                                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white outline-none focus:ring-2 focus:ring-purple-500/30 transition-all"
                            >{testimonialEs.review}</textarea>
                        </div>
                    </section>

                </div>

                <div class="flex justify-end space-x-6 pt-8 border-t border-white/10">
                    <a href="/admin/testimonials" class="px-8 py-3 rounded-xl text-gray-400 hover:text-white transition-all font-medium border border-transparent hover:border-white/10">
                        Cancelar
                    </a>
                    <MagneticButton type="submit" class="px-12 py-3 shadow-lg shadow-blue-500/20">
                        {isNew ? "Crear Testimonio" : "Guardar Cambios"}
                    </MagneticButton>
                </div>
            </form>
        </main>
    </div>
</AdminLayout>
