---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Sidebar from "../../components/admin/Sidebar.astro";
import { Icon } from "astro-icon/components";
import { PortfolioService } from "@/services/data.service";

const user = Astro.locals.user;
const stats = await PortfolioService.getDashboardStats();
const hero = await PortfolioService.getHero("es");

const cards = [
    {
        title: "Proyectos",
        count: stats.projects,
        icon: "mdi:folder-outline",
        color: "text-purple-400",
        bg: "bg-purple-500/10",
        border: "border-purple-500/20",
        link: "/admin/projects",
        description: "Trabajos realizados y casos de estudio."
    },
    {
        title: "Experiencia",
        count: stats.experience,
        icon: "mdi:briefcase-outline",
        color: "text-blue-400",
        bg: "bg-blue-500/10",
        border: "border-blue-500/20",
        link: "/admin/experience",
        description: "Trayectoria profesional y roles."
    },
    {
        title: "Testimonios",
        count: stats.testimonials,
        icon: "mdi:comment-quote-outline",
        color: "text-green-400",
        bg: "bg-green-500/10",
        border: "border-green-500/20",
        link: "/admin/testimonials",
        description: "Reseñas y feedback de clientes."
    }
];

const quickActions = [
    { label: "Añadir Proyecto", link: "/admin/projects/new", icon: "mdi:plus-circle-outline" },
    { label: "Editar Hero", link: "/admin/hero", icon: "mdi:pencil-outline" },
    { label: "Ver Portfolio", link: "/", icon: "mdi:eye-outline", external: true },
];
---

<AdminLayout title="Dashboard">
    <div class="flex">
        <Sidebar />
        <main class="flex-1 p-8 lg:p-12 min-h-screen bg-[#030617]">
            <!-- Header -->
            <header class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-8">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <div class="size-2.5 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.6)] animate-pulse"></div>
                        <p class="text-[10px] font-black text-green-500/80 uppercase tracking-[0.2em]">Sistema Operativo</p>
                    </div>
                    <h1 class="text-5xl font-black text-white tracking-tighter">
                        Dashboard
                    </h1>
                    <p class="text-sm text-gray-500 mt-2 font-medium">
                        Bienvenido de nuevo, <span class="text-white">{user?.email?.split('@')[0]}</span>
                    </p>
                </div>

                <div class="grid grid-cols-2 sm:flex items-center gap-3">
                    {quickActions.map(action => (
                        <a 
                            href={action.link} 
                            target={action.external ? "_blank" : "_self"}
                            class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-xs font-black hover:bg-white/10 hover:border-white/20 transition-all active:scale-95 shadow-lg group"
                        >
                            <Icon name={action.icon} class="size-4 text-purple-400 group-hover:scale-110 transition-transform" />
                            {action.label}
                        </a>
                    ))}
                </div>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                
                <!-- Main Stats -->
                <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-6">
                    {cards.map(card => (
                        <a href={card.link} class={`group p-6 rounded-3xl bg-white/5 border ${card.border} hover:bg-white/[0.08] transition-all duration-300 relative overflow-hidden`}>
                            <!-- Glow effect -->
                            <div class={`absolute -top-10 -right-10 size-32 rounded-full ${card.bg} blur-3xl group-hover:scale-150 transition-transform duration-500 opacity-50`}></div>
                            
                            <div class="relative z-10">
                                <Icon name={card.icon} class={`size-10 ${card.color} mb-4`} />
                                <h3 class="text-lg font-bold text-white/90">{card.title}</h3>
                                <div class="flex items-baseline gap-2 mt-1">
                                    <span class="text-4xl font-black text-white">{card.count}</span>
                                    <span class="text-xs font-medium text-gray-500 uppercase tracking-widest">Items</span>
                                </div>
                                <p class="text-xs text-gray-500 mt-4 leading-relaxed line-clamp-2">
                                    {card.description}
                                </p>
                            </div>
                        </a>
                    ))}

                    <!-- Hero Preview / Status Card -->
                    <div class="md:col-span-3 p-8 rounded-3xl bg-gradient-to-br from-blue-600/20 to-purple-600/20 border border-white/10 relative overflow-hidden group">
                        <div class="absolute inset-0 bg-grid-white/[0.02] bg-[size:20px_20px]"></div>
                        <div class="absolute -bottom-20 -left-20 size-64 bg-blue-500/20 rounded-full blur-[100px]"></div>
                        
                        <div class="relative z-10 flex flex-col md:flex-row gap-8 items-center">
                            <div class="w-32 h-32 rounded-2xl overflow-hidden border-2 border-white/20 shrink-0 rotate-3 group-hover:rotate-0 transition-transform duration-500">
                                <img 
                                    src={hero?.image_url || "/avatar-placeholder.png"} 
                                    alt="Hero Preview" 
                                    class="w-full h-full object-cover"
                                />
                            </div>
                            <div class="flex-1 text-center md:text-left">
                                <div class="flex flex-wrap justify-center md:justify-start gap-2 mb-3">
                                    <span class="px-3 py-1 rounded-full bg-blue-500/20 border border-blue-500/30 text-[10px] font-bold text-blue-300 uppercase tracking-widest">Sección Hero</span>
                                    {hero?.status_available ? (
                                        <span class="px-3 py-1 rounded-full bg-green-500/20 border border-green-500/30 text-[10px] font-bold text-green-300 uppercase tracking-widest">Disponible</span>
                                    ) : (
                                        <span class="px-3 py-1 rounded-full bg-red-500/20 border border-red-500/30 text-[10px] font-bold text-red-300 uppercase tracking-widest">Ocupado</span>
                                    )}
                                </div>
                                <h2 class="text-2xl font-bold text-white mb-2">{hero?.short_description || "Sin descripción"}</h2>
                                <p class="text-gray-400 text-sm max-w-xl line-clamp-2">
                                    {hero?.long_description?.replace(/<[^>]*>?/gm, '') || "Configura tu descripción para empezar."}
                                </p>
                                <a href="/admin/hero" class="mt-6 inline-flex items-center gap-2 text-white font-bold text-sm hover:underline">
                                    Configurar Hero principal →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Secondary Info -->
                <div class="lg:col-span-4 space-y-8">
                    <!-- Portfolio Info -->
                    <div class="p-8 rounded-3xl bg-[#05091e] border border-white/5 shadow-2xl relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-4 opacity-5">
                            <Icon name="mdi:server-network" class="size-24" />
                        </div>
                        
                        <h3 class="text-lg font-black text-white mb-8 flex items-center gap-3">
                            <div class="p-2 rounded-lg bg-blue-500/10 border border-blue-500/20">
                                <Icon name="mdi:pulse" class="size-4 text-blue-400" />
                            </div>
                            Estado del Sistema
                        </h3>
                        
                        <div class="space-y-5">
                            <div class="flex items-center justify-between p-3 rounded-2xl bg-white/[0.02] border border-white/5">
                                <span class="text-xs font-bold text-gray-400">Versión</span>
                                <span class="text-xs font-mono font-black text-purple-400">v2.4.0-premium</span>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-2xl bg-white/[0.02] border border-white/5">
                                <span class="text-xs font-bold text-gray-400">Base de datos</span>
                                <div class="flex items-center gap-2">
                                    <span class="size-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.8)]"></span>
                                    <span class="text-xs font-black text-white">Online</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-2xl bg-white/[0.02] border border-white/5">
                                <span class="text-xs font-bold text-gray-400">Storage</span>
                                <div class="flex flex-col items-end">
                                    <span class="text-xs font-black text-white italic">Activo</span>
                                    <span class="text-[8px] text-blue-400 font-black uppercase tracking-widest mt-1">Bucket: portfolio</span>
                                </div>
                            </div>
                            
                            <div class="pt-4">
                                <div class="p-5 rounded-2xl bg-gradient-to-br from-purple-500/10 to-blue-500/10 border border-purple-500/10 relative group overflow-hidden">
                                     <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                                        <Icon name="mdi:lightbulb-on-outline" class="size-16" />
                                    </div>
                                    <p class="text-[9px] font-black text-purple-400 uppercase tracking-[0.2em] mb-3">Consejo Pro</p>
                                    <p class="text-xs text-gray-300 leading-relaxed font-medium relative z-10">
                                        "Mantén tus testimonios actualizados para dar más confianza a tus potenciales clientes."
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer / Support -->
                    <div class="text-center p-6 grayscale opacity-30 hover:grayscale-0 hover:opacity-100 transition-all">
                        <p class="text-[10px] text-gray-400 font-bold uppercase tracking-[0.2em]">Crafted by Antigravity AI</p>
                    </div>
                </div>

            </div>
        </main>
    </div>
</AdminLayout>

<style>
    .bg-grid-white {
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    }
</style>
