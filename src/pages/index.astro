---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import AboutMe from "@/components/AboutMe.astro";
import TechStack from "@/components/TechStack.astro";
import Testimonials from "@/components/Testimonials.astro";

const title = "Bryan Vela - Desarrollador Web";
const description =
  "Desarrollo soluciones web a medida para impulsar tu presencia digital. +5 años de experiencia creando sitios web atractivos y funcionales que convierten visitantes en clientes.";
---

<Layout title={title} description={description}>
  <Hero />
  <TechStack />
  <Experience />
  <Projects />
  <Testimonials />
  <AboutMe />
</Layout>
