---
import { getI18N } from "@/i18n";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ExperienceItem from "@/components/ui/ExperienceItem.astro";
import { PortfolioService } from "@/services/data.service";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const dbExperience = await PortfolioService.getExperience(currentLocale || "es");

const EXPERIENCE = dbExperience.map(exp => ({
  date: exp.date,
  title: exp.title,
  company: exp.company,
  description: exp.description,
  current: exp.current,
  link: exp.link,
}));
---

<section id="experiencia" class="py-32">
  <div class="container max-w-6xl mx-auto px-4">
    <SectionHeader
      badge="Trayectoria"
      badgeColor="blue"
      title={i18n.EXPERIENCE.SECTION_TITLE}
      highlight={i18n.EXPERIENCE.TITLE_HIGHLIGHT}
      description={i18n.EXPERIENCE.DESCRIPTION}
    />

    <!-- Timeline -->
    <div class="relative">
      <!-- Timeline line with animated gradient -->
      <div
        class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px md:-translate-x-1/2"
      >
        <div
          class="absolute inset-0 bg-gradient-to-b from-accent-purple via-accent-blue to-accent-cyan"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-b from-accent-purple via-accent-blue to-accent-cyan blur-sm opacity-50"
        >
        </div>
      </div>

      <div class="space-y-16">
        {
          EXPERIENCE.map((job, index) => (
            <ExperienceItem 
              job={job} 
              index={index} 
              isLast={index === EXPERIENCE.length - 1}
              isSingle={EXPERIENCE.length === 1}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
