---
import { getI18N } from "@/i18n";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ExperienceItem from "@/components/ui/ExperienceItem.astro";
import type { ExperienceItem as ExperienceItemType } from "@/types";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const EXPERIENCE: ExperienceItemType[] = [
  {
    date: i18n.EXPERIENCE.JOB_1.TIME,
    title: i18n.EXPERIENCE.JOB_1.TITLE,
    company: i18n.EXPERIENCE.JOB_1.SUBTITLE,
    description: i18n.EXPERIENCE.JOB_1.DESCRIPTION,
    current: true,
  },
  {
    date: i18n.EXPERIENCE.JOB_2.TIME,
    title: i18n.EXPERIENCE.JOB_2.TITLE,
    company: i18n.EXPERIENCE.JOB_2.SUBTITLE,
    description: i18n.EXPERIENCE.JOB_2.DESCRIPTION,
    current: true,
  },
  {
    date: i18n.EXPERIENCE.JOB_3.TIME,
    title: i18n.EXPERIENCE.JOB_3.TITLE,
    company: i18n.EXPERIENCE.JOB_3.SUBTITLE,
    description: i18n.EXPERIENCE.JOB_3.DESCRIPTION,
  },
];
---

<section id="experiencia" class="py-32">
  <div class="container max-w-6xl mx-auto px-4">
    <SectionHeader
      badge={i18n.EXPERIENCE.BADGE}
      badgeColor="blue"
      title={i18n.EXPERIENCE.SECTION_TITLE.replace("Profesional", "")
        .replace("Work", "")
        .trim()}
      highlight={i18n.EXPERIENCE.TITLE_HIGHLIGHT}
      description={i18n.EXPERIENCE.DESCRIPTION}
    />

    <!-- Timeline -->
    <div class="relative">
      <!-- Timeline line with animated gradient -->
      <div
        class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px md:-translate-x-1/2"
      >
        <div
          class="absolute inset-0 bg-gradient-to-b from-accent-purple via-accent-blue to-accent-cyan"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-b from-accent-purple via-accent-blue to-accent-cyan blur-sm opacity-50"
        >
        </div>
      </div>

      <div class="space-y-16">
        {
          EXPERIENCE.map((job, index) => (
            <ExperienceItem job={job} index={index} />
          ))
        }
      </div>
    </div>
  </div>
</section>
