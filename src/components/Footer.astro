---
import { Icon } from "astro-icon/components";
import { getI18N } from "@/i18n";
import MagneticButton from "@/components/ui/MagneticButton.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const currentYear = new Date().getFullYear();
import { PortfolioService } from "@/services/data.service";

const globalSettings = await PortfolioService.getGlobalSettings();
const email = globalSettings?.email || "";
const phone = globalSettings?.phone || "";
const cleanPhone = phone.replace(/\D/g, "");
const whatsappUrl = globalSettings?.whatsapp_url || (cleanPhone ? `https://api.whatsapp.com/send?phone=${cleanPhone}` : "");
const brandName = globalSettings?.brand_name || "bdvela";

const socialLinks = [
  {
    href: globalSettings?.linkedin_url || "",
    icon: "mdi:linkedin",
    label: "LinkedIn",
    hoverBg: "hover:bg-blue-600",
  },
  {
    href: globalSettings?.github_url || "",
    icon: "mdi:github",
    label: "GitHub",
    hoverBg: "hover:bg-dark-600",
  },
  {
    href: email ? `mailto:${email}` : "",
    icon: "mdi:email-outline",
    label: "Email",
    hoverBg: "hover:bg-accent-purple",
  },
  {
    href: globalSettings?.instagram_url || "",
    icon: "mdi:instagram",
    label: "Instagram",
    hoverBg: "hover:bg-rose-600",
  },
  {
    href: globalSettings?.facebook_url || "",
    icon: "mdi:facebook",
    label: "Facebook",
    hoverBg: "hover:bg-blue-700",
  },
  {
    href: whatsappUrl,
    icon: "mdi:whatsapp",
    label: "WhatsApp",
    hoverBg: "hover:bg-green-600",
  },
].filter(link => link.href);
---

<footer class="relative py-24 mt-20">
  <!-- Top gradient line -->
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-purple/50 to-transparent"
  >
  </div>

  <div class="container max-w-6xl mx-auto px-4">
    <!-- CTA Section -->
    <div class="text-center mb-24 reveal">
      <span
        class="inline-block px-4 py-2 rounded-full bg-accent-purple/10 border border-accent-purple/20 text-accent-purple text-sm font-medium mb-6"
      >
        {i18n.FOOTER.CTA_BADGE}
      </span>

      <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
        {i18n.FOOTER.CTA_TITLE_PART_1}
        <br class="hidden sm:block" />
        <span class="gradient-text">{i18n.FOOTER.CTA_TITLE_HIGHLIGHT}</span>
      </h2>

      <p class="text-lg md:text-xl text-dark-400 max-w-xl mx-auto mb-10">
        {i18n.FOOTER.CTA_DESCRIPTION}
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <MagneticButton href={whatsappUrl} variant="primary" size="lg">
          <Icon name="mdi:whatsapp" class="size-5" />
          {i18n.FOOTER.BUTTON_WHATSAPP}
        </MagneticButton>

        <MagneticButton
          href={`mailto:${email}`}
          variant="secondary"
          size="lg"
        >
          <Icon name="mdi:email-outline" class="size-5" />
          {i18n.FOOTER.BUTTON_EMAIL}
        </MagneticButton>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-8 pt-12 border-t border-dark-800/50"
    >
      <!-- Brand -->
      <div class="flex flex-col items-center md:items-start gap-1">
        <span class="text-2xl font-bold gradient-text">{brandName}</span>
        <span class="text-sm text-dark-500">{i18n.FOOTER.ROLE}</span>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-2">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={
                link.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
              class={`w-11 h-11 rounded-xl flex items-center justify-center bg-dark-800/50 text-dark-400 border border-dark-700/50
              ${link.hoverBg} hover:text-white hover:border-transparent transition-all duration-300`}
              aria-label={link.label}
            >
              <Icon name={link.icon} class="size-5" />
            </a>
          ))
        }
      </div>

      <!-- Copyright -->
      <div class="text-center md:text-right">
        <p class="text-sm text-dark-500">
          © {currentYear} {brandName}
        </p>
        <p
          class="text-xs text-dark-600 mt-1 flex items-center gap-1 justify-center md:justify-end"
        >
          {i18n.FOOTER.MADE_WITH}
          <span class="text-red-400">♥</span> en
          <span class="inline-flex items-center gap-1">
            <span>🇵🇪</span>
            {i18n.FOOTER.IN_PERU}
          </span>
        </p>
      </div>
    </div>
  </div>
</footer>
