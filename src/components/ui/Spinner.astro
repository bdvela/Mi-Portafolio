---
/**
 * Spinner Component
 * Simple, elegant CSS spinner for button loading states
 */
interface Props {
    size?: "sm" | "md" | "lg";
    class?: string;
}

const { size = "sm", class: className = "" } = Astro.props;

const sizes = {
    sm: "size-4 border-2",
    md: "size-6 border-2",
    lg: "size-8 border-3",
};
---

<div 
    class={`inline-block animate-spin rounded-full border-solid border-current border-r-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite] ${sizes[size]} ${className}`}
    role="status"
>
    <span class="sr-only">Cargando...</span>
</div>
