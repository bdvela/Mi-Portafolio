---
import { Icon } from "astro-icon/components";
import MagneticButton from "@/components/ui/MagneticButton.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import type { Project } from "@/types";

interface Props {
    project: Project;
    index: number;
    i18n: {
        VIEW_PROJECT: string;
    };
}

const { project, index, i18n } = Astro.props;
---

<article
    class={`group reveal ${project.featured ? "md:col-span-2" : ""}`}
    style={`animation-delay: ${index * 100}ms`}
>
    <GlassCard
        class="h-full overflow-hidden"
        padding="none"
        gradient={project.gradient}
    >
        <div class={`${project.featured ? "flex flex-col lg:flex-row" : ""}`}>
            <!-- Image -->
            <div
                class={`relative overflow-hidden ${project.featured ? "lg:w-3/5 h-72 md:h-96 lg:h-[30rem]" : "aspect-video"}`}
            >
                <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"
                >
                </div>

                {/* Highlight New Projects */}
                {
                    project.new && (
                        <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-accent-pink text-white text-xs font-bold shadow-lg shadow-accent-pink/20 animate-pulse">
                            NEW
                        </div>
                    )
                }

                <!-- Floating project number -->
                <div
                    class="absolute top-4 left-4 w-10 h-10 rounded-xl bg-dark-950/80 backdrop-blur-sm flex items-center justify-center text-sm font-bold text-dark-400 border border-dark-700"
                >
                    {String(index + 1).padStart(2, "0")}
                </div>
            </div>

            <!-- Content -->
            <div
                class={`p-6 md:p-8 ${project.featured ? "lg:w-2/5 lg:p-10 flex flex-col justify-center" : ""}`}
            >
                <!-- Subtitle -->
                <span class="text-accent-purple text-sm font-medium mb-2 block">
                    {project.subtitle}
                </span>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2 mb-4">
                    {
                        project.tags.map((tag) => (
                            <span
                                class="px-3 py-1 rounded-full text-xs font-medium bg-dark-800/50 text-dark-300 border border-dark-700 
                      group-hover:border-accent-purple/30 transition-colors"
                            >
                                {tag}
                            </span>
                        ))
                    }
                </div>

                <h3
                    class="text-2xl md:text-3xl font-bold mb-3 text-white group-hover:text-accent-purple transition-colors duration-300"
                >
                    {project.title}
                </h3>

                <p class="text-dark-400 mb-6 leading-relaxed">
                    {project.description}
                </p>

                <!-- Links -->
                <div class="flex gap-3 mt-auto">
                    {
                        project.link !== "#" && (
                            <MagneticButton
                                href={project.link}
                                variant="primary"
                                size="sm"
                            >
                                {i18n.VIEW_PROJECT}
                                <Icon name="mdi:arrow-right" class="size-4" />
                            </MagneticButton>
                        )
                    }
                    {
                        project.github && (
                            <MagneticButton
                                href={project.github}
                                variant="ghost"
                                size="sm"
                            >
                                <Icon name="mdi:github" class="size-5" />
                            </MagneticButton>
                        )
                    }
                </div>
            </div>
        </div>
    </GlassCard>
</article>
