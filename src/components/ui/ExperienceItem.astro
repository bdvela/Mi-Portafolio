---
import { Icon } from "astro-icon/components";
import GlassCard from "@/components/ui/GlassCard.astro";
import type { ExperienceItem } from "@/types";

interface Props {
    job: ExperienceItem;
    index: number;
}

const { job, index } = Astro.props;
const isEven = index % 2 === 0;
---

<div
    class={`relative flex flex-col md:flex-row gap-8 md:gap-16 reveal ${!isEven ? "md:flex-row-reverse" : ""}`}
    style={`animation-delay: ${index * 150}ms`}
>
    <!-- Timeline dot -->
    <div
        class="absolute left-4 md:left-1/2 w-3 h-3 rounded-full bg-dark-950 ring-4 ring-accent-purple -translate-x-1/2 mt-6 z-10"
    >
        {
            job.current && (
                <span class="absolute inset-0 rounded-full bg-accent-purple animate-ping opacity-50" />
            )
        }
    </div>

    <!-- Content -->
    <div
        class={`flex-1 ml-12 md:ml-0 ${isEven ? "md:text-right md:pr-20" : "md:pl-20"}`}
    >
        <GlassCard padding="md">
            <!-- Date badge -->
            <div class={`flex ${isEven ? "md:justify-end" : "justify-start"}`}>
                <span
                    class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium mb-4
            ${
                job.current
                    ? "bg-green-500/10 text-green-400 border border-green-500/20"
                    : "bg-dark-800/50 text-dark-400 border border-dark-700"
            }`}
                >
                    {
                        job.current && (
                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" />
                        )
                    }
                    {job.date}
                </span>
            </div>

            <h3
                class="text-xl md:text-2xl font-bold text-white mb-2 group-hover:text-accent-purple transition-colors"
            >
                {job.title}
            </h3>

            <p
                class={`text-accent-purple mb-4 font-medium flex items-center gap-2 ${isEven ? "md:justify-end" : ""}`}
            >
                <Icon name="mdi:office-building" class="size-4" />
                {job.company}
            </p>

            <p class="text-dark-400 leading-relaxed">
                {job.description}
            </p>
        </GlassCard>
    </div>

    <!-- Empty space for timeline alignment -->
    <div class="hidden md:block flex-1"></div>
</div>
