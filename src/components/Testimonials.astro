---
import { getI18N } from "@/i18n";
import GlassCard from "@/components/ui/GlassCard.astro";
import { Icon } from "astro-icon/components";
import { PortfolioService } from "@/services/data.service";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const dbTestimonials = await PortfolioService.getTestimonials(currentLocale || "es");

const REVIEWS = dbTestimonials.length > 0 ? dbTestimonials.map(t => ({
    text: t.review,
    author: t.author,
    company: t.company,
    initial: t.author.substring(0, 2).toUpperCase(),
})) : [
    {
        text: i18n.TESTIMONIALS.REVIEW_1,
        author: i18n.TESTIMONIALS.AUTHOR_1,
        company: i18n.TESTIMONIALS.COMPANY_1,
        initial: "GM",
    },
    {
        text: i18n.TESTIMONIALS.REVIEW_2,
        author: i18n.TESTIMONIALS.AUTHOR_2,
        company: i18n.TESTIMONIALS.COMPANY_2,
        initial: "BZ",
    },
    {
        text: i18n.TESTIMONIALS.REVIEW_3,
        author: i18n.TESTIMONIALS.AUTHOR_3,
        company: i18n.TESTIMONIALS.COMPANY_3,
        initial: "CH",
    },
];
---

<section class="py-24 overflow-hidden relative">
    <div class="container max-w-6xl mx-auto px-4 mb-16 text-center">
        <span
            class="inline-block px-4 py-2 rounded-full bg-accent-pink/10 border border-accent-pink/20 text-accent-pink text-sm font-medium mb-6"
        >
            {i18n.TESTIMONIALS.SUBTITLE}
        </span>
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
            {i18n.TESTIMONIALS.TITLE}
        </h2>
    </div>

    <div class="relative">
        <!-- Fades -->
        <div
            class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-dark-950 to-transparent z-10 pointer-events-none"
        >
        </div>
        <div
            class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-dark-950 to-transparent z-10 pointer-events-none"
        >
        </div>

        <!-- Marquee -->
        <div
            class="flex animate-marquee hover:[animation-play-state:paused] w-max"
        >
            {
                [...REVIEWS, ...REVIEWS, ...REVIEWS, ...REVIEWS].map(
                    (review) => (
                        <div class="w-[350px] md:w-[450px] mx-4 shrink-0">
                            <GlassCard
                                padding="lg"
                                class="h-full group hover:-translate-y-2 transition-transform duration-300"
                            >
                                <div class="flex items-start gap-4 mb-6">
                                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-accent-purple to-accent-blue flex items-center justify-center text-white font-bold text-sm shrink-0">
                                        {review.initial}
                                    </div>
                                    <div>
                                        <p class="font-bold text-white">
                                            {review.company}
                                        </p>
                                        <p class="text-xs text-accent-purple uppercase tracking-wider">
                                            {review.author}
                                        </p>
                                    </div>
                                    <Icon
                                        name="mdi:format-quote-close"
                                        class="ml-auto text-dark-700 size-8 group-hover:text-accent-purple/30 transition-colors"
                                    />
                                </div>

                                <p class="text-dark-300 leading-relaxed italic">
                                    "{review.text}"
                                </p>

                                <div class="flex gap-1 mt-6">
                                    <Icon
                                        name="mdi:star"
                                        class="text-yellow-400 size-4"
                                    />
                                    <Icon
                                        name="mdi:star"
                                        class="text-yellow-400 size-4"
                                    />
                                    <Icon
                                        name="mdi:star"
                                        class="text-yellow-400 size-4"
                                    />
                                    <Icon
                                        name="mdi:star"
                                        class="text-yellow-400 size-4"
                                    />
                                    <Icon
                                        name="mdi:star"
                                        class="text-yellow-400 size-4"
                                    />
                                </div>
                            </GlassCard>
                        </div>
                    ),
                )
            }
        </div>
    </div>
</section>
