---
import { Icon } from "astro-icon/components";
const { url } = Astro;
const pathname = url.pathname;

const menuItems = [
    { name: "Dashboard", icon: "mdi:view-dashboard-outline", href: "/admin" },
    {
        name: "Sección Hero",
        icon: "mdi:account-star-outline",
        href: "/admin/hero",
    },
    {
        name: "Experiencia",
        icon: "mdi:briefcase-outline",
        href: "/admin/experience",
    },
    {
        name: "Proyectos",
        icon: "mdi:folder-multiple-outline",
        href: "/admin/projects",
    },
    {
        name: "Testimonios",
        icon: "mdi:comment-quote-outline",
        href: "/admin/testimonials",
    },
    {
        name: "Sobre mí",
        icon: "mdi:account-details-outline",
        href: "/admin/about",
    },
    { name: "Configuraciones", icon: "mdi:cog", href: "/admin/settings" },
];
---

<!-- Mobile Admin Header (only appears when this component is included) -->
<div
    id="admin-mobile-header"
    class="lg:hidden sticky top-0 z-[55] w-full px-5 py-4 bg-[#05091e]/95 backdrop-blur-2xl border-b border-white/5 flex items-center justify-between shadow-2xl"
>
    <div class="flex items-center gap-3">
        <div class="size-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-purple-500/20">
            <Icon name="mdi:shield-crown-outline" class="size-5 text-white" />
        </div>
        <div class="flex flex-col">
            <h2 class="text-sm font-black text-white tracking-tighter">Control Center</h2>
            <span class="text-[8px] font-black text-purple-400 uppercase tracking-widest">Premium</span>
        </div>
    </div>
    <button
        id="admin-menu-toggle"
        class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-white active:scale-90 transition-all shadow-inner"
        aria-label="Abrir menú"
    >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8h16M4 16h16" />
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="size-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>
</div>

<!-- Mobile Sidebar Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[59] opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

<!-- Sidebar -->
<aside
    id="admin-sidebar"
    class="fixed inset-y-0 left-0 w-72 bg-[#05091e] border-r border-white/5 flex flex-col h-screen z-[60] -translate-x-full lg:translate-x-0 transition-transform duration-300 lg:sticky lg:top-0"
>
    <div class="px-8 py-10 border-b border-white/5">
        <div class="flex items-center gap-3">
            <div class="size-10 rounded-xl bg-gradient-to-br from-indigo-500 via-purple-600 to-pink-500 flex items-center justify-center shadow-[0_0_20px_rgba(139,92,246,0.3)] animate-pulse-subtle">
                <Icon name="mdi:shield-crown-outline" class="size-6 text-white" />
            </div>
            <div>
                <h2 class="text-xl font-black text-white tracking-tighter bg-gradient-to-r from-white to-white/60 bg-clip-text text-transparent">
                    Control
                </h2>
                <p class="text-[9px] font-black text-purple-400/80 uppercase tracking-[0.2em]">
                    Premium Suite
                </p>
            </div>
        </div>
    </div>

    <nav class="flex-1 p-6 space-y-2 overflow-y-auto custom-scrollbar">
        {
            menuItems.map((item) => {
                const isActive =
                    pathname === item.href ||
                    (item.href !== "/admin" && pathname.startsWith(item.href));
                return (
                    <a
                        href={item.href}
                        class={`flex items-center gap-4 px-5 py-3.5 rounded-2xl transition-all duration-300 group ${
                            isActive
                                ? "bg-gradient-to-r from-purple-600/20 to-blue-600/20 text-white border border-white/10 shadow-xl shadow-black/20"
                                : "text-gray-400 hover:bg-white/[0.03] border border-transparent hover:text-white"
                        }`}
                    >
                        <Icon
                            name={item.icon}
                            class={`size-6 transition-transform duration-300 ${isActive ? "text-purple-400 scale-110" : "group-hover:scale-110"}`}
                        />
                        <span
                            class={`font-black text-sm tracking-tight ${isActive ? "text-white" : "group-hover:text-white"}`}
                        >
                            {item.name}
                        </span>
                        {isActive && (
                            <div class="ml-auto w-1.5 h-1.5 rounded-full bg-purple-500 shadow-[0_0_10px_rgba(168,85,247,0.8)]" />
                        )}
                    </a>
                );
            })
        }
    </nav>

    <div class="p-6 border-t border-white/5 space-y-3">
        <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/5 border border-white/5 mb-2">
            <div class="size-8 rounded-full bg-gradient-to-tr from-purple-500 to-blue-500 flex items-center justify-center text-[10px] font-bold text-white shadow-lg">
                AD
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-white truncate">Administrador</p>
                <p class="text-[9px] text-gray-500 truncate lowercase">Sesión Activa</p>
            </div>
        </div>

        <a
            href="/"
            target="_blank"
            class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-xl bg-white/10 text-white hover:bg-white/20 transition-all text-xs font-bold border border-white/10 shadow-sm"
        >
            <Icon name="mdi:web" class="size-4" />
            Sitio Público
        </a>
        <a
            href="/admin/api/signout"
            class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-xl text-red-400/70 hover:text-white hover:bg-red-500/20 transition-all text-xs font-bold border border-red-500/10"
        >
            <Icon name="mdi:logout" class="size-4" />
            Cerrar Sesión
        </a>
    </div>
</aside>

<!-- Sidebar Toggle Script (self-contained) -->
<script>
    document.addEventListener('astro:page-load', () => {
        const sidebar = document.getElementById('admin-sidebar');
        const toggle = document.getElementById('admin-menu-toggle');
        const overlay = document.getElementById('sidebar-overlay');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');

        if (!sidebar || !toggle || !overlay) return;

        let isOpen = false;

        const openSidebar = () => {
            isOpen = true;
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            overlay.classList.add('opacity-100');
            document.body.classList.add('overflow-hidden');
            if (iconOpen) iconOpen.classList.add('hidden');
            if (iconClose) iconClose.classList.remove('hidden');
        };

        const closeSidebar = () => {
            isOpen = false;
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('opacity-0', 'pointer-events-none');
            overlay.classList.remove('opacity-100');
            document.body.classList.remove('overflow-hidden');
            if (iconOpen) iconOpen.classList.remove('hidden');
            if (iconClose) iconClose.classList.add('hidden');
        };

        toggle.addEventListener('click', () => {
            if (isOpen) closeSidebar();
            else openSidebar();
        });

        overlay.addEventListener('click', closeSidebar);

        // Close sidebar when a link is clicked (mobile navigation)
        sidebar.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                if (isOpen) closeSidebar();
            });
        });

        // Close sidebar on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isOpen) closeSidebar();
        });
    });
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    @keyframes pulse-subtle {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.9; transform: scale(0.98); }
    }
    .animate-pulse-subtle {
        animation: pulse-subtle 3s ease-in-out infinite;
    }
</style>
