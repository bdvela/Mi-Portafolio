---
import { getI18N } from '@/i18n';
import { Icon } from 'astro-icon/components';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import MagneticButton from '@/components/ui/MagneticButton.astro';

const {currentLocale} = Astro
const i18n = getI18N({currentLocale})

const PROJECTS = [
  {
    title: i18n.PROJECTS.PROJECT_NEW.TITLE,
    subtitle: i18n.PROJECTS.PROJECT_NEW.SUBTITLE,
    description: i18n.PROJECTS.PROJECT_NEW.DESCRIPTION,
    link: "https://arazevallos.com",
    image: "/ara_zevallos.png",
    tags: ["Next.js 16", "Shopify", "Framer Motion", "Tailwind v4"],
    featured: true,
    new: true,
    gradient: "from-pink-500/20 to-rose-500/20",
  },
  {
    title: i18n.PROJECTS.PROJECT_1.TITLE,
    subtitle: i18n.PROJECTS.PROJECT_1.SUBTITLE,
    description: i18n.PROJECTS.PROJECT_1.DESCRIPTION,
    link: "https://mofima.com/",
    image: "/grupo-mofima.webp",
    tags: ["Astro", "Tailwind"],
    featured: true,
    gradient: "from-amber-500/20 to-orange-500/20",
  },
  {
    title: i18n.PROJECTS.PROJECT_2.TITLE,
    subtitle: i18n.PROJECTS.PROJECT_2.SUBTITLE,
    description: i18n.PROJECTS.PROJECT_2.DESCRIPTION,
    link: "https://beizzon.com",
    image: "/beizzon.webp",
    tags: ["React", "Spring Boot", "Tailwind"],
    featured: true,
    gradient: "from-blue-500/20 to-cyan-500/20",
  },
  {
    title: i18n.PROJECTS.PROJECT_3.TITLE,
    subtitle: i18n.PROJECTS.PROJECT_3.SUBTITLE,
    description: i18n.PROJECTS.PROJECT_3.DESCRIPTION,
    image: "/chiringuito.webp",
    link: "https://chiringuito.pe/",
    tags: ["WordPress", "WooCommerce"],
    gradient: "from-red-500/20 to-pink-500/20",
  },
  {
    title: i18n.PROJECTS.PROJECT_4.TITLE,
    subtitle: i18n.PROJECTS.PROJECT_4.SUBTITLE,
    description: i18n.PROJECTS.PROJECT_4.DESCRIPTION,
    image: "/retcamp_2022.webp",
    link: "https://bdvela.github.io/cvc-retcamp/",
    github: "https://github.com/bdvela/cvc-retcamp",
    tags: ["JavaScript", "FullPage.js"],
    gradient: "from-purple-500/20 to-indigo-500/20",
  },
  {
    title: i18n.PROJECTS.PROJECT_5.TITLE,
    subtitle: i18n.PROJECTS.PROJECT_5.SUBTITLE,
    description: i18n.PROJECTS.PROJECT_5.DESCRIPTION,
    image: "/diswallet.webp",
    link: "https://diswallet-sx62.web.app/",
    github: "https://github.com/bdvela/DISWALLET",
    tags: ["Vue.js", "Firebase"],
    gradient: "from-green-500/20 to-emerald-500/20",
  },
  {
    title: i18n.PROJECTS.PROJECT_6.TITLE,
    subtitle: i18n.PROJECTS.PROJECT_6.SUBTITLE,
    description: i18n.PROJECTS.PROJECT_6.DESCRIPTION,
    image: "/task_manager.webp",
    link: "https://agenda-3c731.web.app/",
    github: "https://github.com/bdvela/Task-Manager",
    tags: ["Vue.js", "Firebase"],
    gradient: "from-violet-500/20 to-purple-500/20",
  },
]
---

<section id="proyectos" class="py-32">
  <div class="container max-w-6xl mx-auto px-4">
    
    <SectionHeader 
      badge={i18n.PROJECTS.BADGE}
      badgeColor="purple"
      title={i18n.PROJECTS.SECTION_TITLE}
      highlight={i18n.PROJECTS.TITLE_HIGHLIGHT}
      description={i18n.PROJECTS.DESCRIPTION}
    />

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {PROJECTS.map((project, index) => (
        <article 
          class={`group reveal ${project.featured ? 'md:col-span-2' : ''}`}
          style={`animation-delay: ${index * 100}ms`}
        >
          <GlassCard 
            class="h-full overflow-hidden" 
            padding="none"
            gradient={project.gradient}
          >
            <div class={`${project.featured ? 'flex flex-col lg:flex-row' : ''}`}>
              
              <!-- Image -->
              <div class={`relative overflow-hidden ${project.featured ? 'lg:w-3/5 h-72 md:h-96 lg:h-[30rem]' : 'aspect-video'}`}>
                <img 
                  src={project.image} 
                  alt={project.title}
                  class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"></div>
                
                {/* Highlight New Projects */}
                {project.new && (
                    <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-accent-pink text-white text-xs font-bold shadow-lg shadow-accent-pink/20 animate-pulse">
                        NEW
                    </div>
                )}
                
                <!-- Floating project number -->
                <div class="absolute top-4 left-4 w-10 h-10 rounded-xl bg-dark-950/80 backdrop-blur-sm flex items-center justify-center text-sm font-bold text-dark-400 border border-dark-700">
                  {String(index + 1).padStart(2, '0')}
                </div>
              </div>

              <!-- Content -->
              <div class={`p-6 md:p-8 ${project.featured ? 'lg:w-2/5 lg:p-10 flex flex-col justify-center' : ''}`}>
                <!-- Subtitle -->
                <span class="text-accent-purple text-sm font-medium mb-2 block">
                  {project.subtitle}
                </span>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.tags.map((tag) => (
                    <span class="px-3 py-1 rounded-full text-xs font-medium bg-dark-800/50 text-dark-300 border border-dark-700 
                      group-hover:border-accent-purple/30 transition-colors">
                      {tag}
                    </span>
                  ))}
                </div>

                <h3 class="text-2xl md:text-3xl font-bold mb-3 text-white group-hover:text-accent-purple transition-colors duration-300">
                  {project.title}
                </h3>

                <p class="text-dark-400 line-clamp-3 mb-6 leading-relaxed">
                  {project.description}
                </p>

                <!-- Links -->
                <div class="flex gap-3 mt-auto">
                  {project.link !== '#' && (
                    <MagneticButton href={project.link} variant="primary" size="sm">
                      {i18n.PROJECTS.VIEW_PROJECT}
                      <Icon name="mdi:arrow-right" class="size-4" />
                    </MagneticButton>
                  )}
                  {project.github && (
                    <MagneticButton href={project.github} variant="ghost" size="sm">
                      <Icon name="mdi:github" class="size-5" />
                    </MagneticButton>
                  )}
                </div>
              </div>
            </div>
          </GlassCard>
        </article>
      ))}
    </div>

  </div>
</section>