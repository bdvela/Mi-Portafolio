---
import { getI18N } from "@/i18n";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";
import { PortfolioService } from "@/services/data.service";
import type { Project } from "@/types";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const dbProjects = await PortfolioService.getProjects(currentLocale || "es");

const PROJECTS: Project[] = dbProjects.map(p => ({
  title: p.title,
  subtitle: p.subtitle,
  description: p.description,
  link: p.link,
  github: p.github,
  image: p.image,
  tags: p.tags,
  featured: p.featured,
  new: p.is_new,
  gradient: p.gradient || "from-purple-500/20 to-blue-500/20",
}));
---

<section id="proyectos" class="py-32">
  <div class="container max-w-6xl mx-auto px-4">
    <SectionHeader
      badge={i18n.PROJECTS.BADGE}
      badgeColor="purple"
      title={i18n.PROJECTS.SECTION_TITLE}
      highlight={i18n.PROJECTS.TITLE_HIGHLIGHT}
      description={i18n.PROJECTS.DESCRIPTION}
    />

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        PROJECTS.map((project, index) => (
          <ProjectCard project={project} index={index} i18n={i18n.PROJECTS} />
        ))
      }
    </div>
  </div>
</section>
