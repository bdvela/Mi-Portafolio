---
import { ViewTransitions } from "astro:transitions";
import PageLoader from "@/components/ui/PageLoader.astro";
import { Icon } from "astro-icon/components";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Admin Portfolio</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&display=swap" rel="stylesheet">
        <ViewTransitions />
    </head>
    <body class="bg-[#050505] text-white font-['Onest']">
        <PageLoader />
        <div class="relative h-full w-full bg-slate-950">
            <div class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
            
            <!-- Mobile Admin Header -->
            <div class="lg:hidden sticky top-0 z-[55] w-full px-5 py-4 bg-[#05091e]/90 backdrop-blur-2xl border-b border-white/5 flex items-center justify-between shadow-2xl">
                <div class="flex items-center gap-3">
                    <div class="size-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-purple-500/20">
                        <Icon name="mdi:shield-crown-outline" class="size-5 text-white" />
                    </div>
                    <div class="flex flex-col">
                        <h2 class="text-sm font-black text-white tracking-tighter">Control Center</h2>
                        <span class="text-[8px] font-black text-purple-400 uppercase tracking-widest">Premium</span>
                    </div>
                </div>
                <button id="admin-menu-toggle" class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-white active:scale-90 transition-all shadow-inner">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8h16M4 16h16" />
                    </svg>
                </button>
            </div>

            <!-- Mobile Sidebar Overlay -->
            <div id="sidebar-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[59] opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

            <div class="relative z-10 flex flex-col min-h-screen">
                <slot />
            </div>
        </div>
        
        <script>
            // Handle loading state on submit buttons globally in admin
            document.addEventListener('astro:page-load', () => {
                const sidebar = document.getElementById('admin-sidebar');
                const toggle = document.getElementById('admin-menu-toggle');
                const overlay = document.getElementById('sidebar-overlay');

                if (sidebar && toggle && overlay) {
                    const toggleSidebar = () => {
                        sidebar.classList.toggle('-translate-x-full');
                        overlay.classList.toggle('opacity-0');
                        overlay.classList.toggle('pointer-events-none');
                        document.body.classList.toggle('overflow-hidden');
                    };

                    toggle.addEventListener('click', toggleSidebar);
                    overlay.addEventListener('click', toggleSidebar);

                    // Close sidebar on navigation (link click)
                    const links = sidebar.querySelectorAll('a');
                    links.forEach(link => {
                        link.addEventListener('click', () => {
                            if (!sidebar.classList.contains('-translate-x-full')) {
                                toggleSidebar();
                            }
                        });
                    });
                }

                const forms = document.querySelectorAll('form');
                forms.forEach(form => {
                    form.addEventListener('submit', () => {
                        const submitButton = form.querySelector('button[type="submit"]');
                        if (submitButton) {
                            // If it's our MagneticButton, it has specific classes
                            if (submitButton.classList.contains('magnetic-btn')) {
                                // Add loading state to our custom button
                                // Since we can't easily change props in plain JS after SSR, 
                                // we'll manually toggle the visibility/spinner for immediate feedback
                                const content = submitButton.querySelector('.magnetic-content');
                                if (content) content.classList.add('opacity-0', 'invisible');
                                
                                // Check if spinner already exists, otherwise add it
                                if (!submitButton.querySelector('.animate-spin')) {
                                    const spinnerDiv = document.createElement('div');
                                    spinnerDiv.className = 'absolute inset-0 flex items-center justify-center z-20';
                                    spinnerDiv.innerHTML = '<div class="inline-block animate-spin rounded-full border-solid border-current border-r-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite] size-6 border-2" role="status"><span class="sr-only">Cargando...</span></div>';
                                    submitButton.appendChild(spinnerDiv);
                                }
                                
                                submitButton.classList.add('cursor-wait', 'opacity-80');
                                (submitButton as HTMLButtonElement).disabled = true;
                            } else {
                                // Generic button handling
                                submitButton.classList.add('opacity-50', 'cursor-wait');
                                (submitButton as HTMLButtonElement).disabled = true;
                            }
                        }
                    });
                });
            });
        </script>
    </body>
</html>

<style is:global>
    :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
            45deg,
            rgb(var(--accent)),
            rgb(var(--accent-light)) 30%,
            white 60%
        );
    }
    html {
        font-family: 'Onest', system-ui, sans-serif;
    }
</style>
